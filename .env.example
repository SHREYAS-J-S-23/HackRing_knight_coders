# ====================================================
# VIDARA PIPELINE CONFIGURATION: DUAL AI KEYS & MODELS
# ====================================================
# KEY 1: VIDEO ANALYSIS (Whisper STT, timestamps, segmentation)
VIDEO_ANALYSIS_API_KEY=your_groq_stt_api_key_here
VIDEO_ANALYSIS_MODEL=whisper-large-v3

# KEY 2: AI REASONING (User query understanding, topic inference, editorial decisions)
REASONING_API_KEY=your_groq_llm_api_key_here
REASONING_MODEL=qwen/qwen3.8-27b
REASONING_FALLBACK_MODEL=llama-3.3-70b-versatile

# Master Groq Key (Used automatically if dedicated keys above are blank)
GROQ_API_KEY=your_master_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Storage Paths
UPLOAD_DIR=storage/uploads
AUDIO_DIR=storage/audio
OUTPUT_DIR=storage/outputs

# Performance & Speed Optimization Settings
TRANSCRIPTION_MODE=FAST               # FAST (whisper-large-v3-turbo, segment-level) or PRECISE (whisper-large-v3, word-level)
GROQ_WHISPER_FAST_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_PRECISE_MODEL=whisper-large-v3
TRANSCRIPTION_CHUNK_SECONDS=300.0     # Audio chunk duration (5 minutes)
TRANSCRIPTION_OVERLAP_SECONDS=2.0     # Boundary overlap in seconds to prevent clipped words
TRANSCRIPTION_MAX_CONCURRENCY=2       # Bounded parallel workers to prevent rate-limit throttling
TRANSCRIPTION_MAX_RETRIES=3           # Exponential backoff retries on transient errors
TRANSCRIPTION_TIMEOUT_SECONDS=60.0    # STT HTTP request timeout

DIARIZATION_MODE=FAST                 # FAST (rule-based turns, 0 ffmpeg calls), STANDARD, or PRECISE (batched acoustic)
REASONING_TIMEOUT_SECONDS=25.0        # LLM reasoning request timeout

# Server Settings
HOST=127.0.0.1
PORT=8000

# ====================================================
# SUPABASE POSTGRESQL & STORAGE CONFIGURATION
# ====================================================
# Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Public Key (for client-side or anon operations)
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Secret Key (REQUIRED for server-side persistence, background jobs, storage bypass)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Optional: Direct PostgreSQL Connection URI (Session/Transaction pooler or Direct)
# e.g., postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_VIDEOS=original-videos
SUPABASE_STORAGE_BUCKET_AUDIO=processed-audio
SUPABASE_STORAGE_BUCKET_CLIPS=generated-clips
SUPABASE_STORAGE_BUCKET_SUBTITLES=subtitles
SUPABASE_STORAGE_BUCKET_EXPORTS=final-exports

# Optional: Offline/Local Fallback JWT Secret (used when Supabase is not configured)
JWT_SECRET=your_vidara_jwt_fallback_secret_key
