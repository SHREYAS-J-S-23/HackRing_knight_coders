# ====================================================
# VIDARA PIPELINE CONFIGURATION: DUAL AI KEYS & MODELS
# ====================================================
# KEY 1: VIDEO ANALYSIS (Whisper STT, timestamps, segmentation)
VIDEO_ANALYSIS_API_KEY=your_groq_stt_api_key_here
VIDEO_ANALYSIS_MODEL=whisper-large-v3

# KEY 2: AI REASONING (User query understanding, topic inference, editorial decisions)
REASONING_API_KEY=your_groq_llm_api_key_here
REASONING_MODEL=qwen/qwen3.8-27b
REASONING_FALLBACK_MODEL=llama-3.3-70b-versatile

# Master Groq Key (Used automatically if dedicated keys above are blank)
GROQ_API_KEY=your_master_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Storage Paths
UPLOAD_DIR=storage/uploads
AUDIO_DIR=storage/audio
OUTPUT_DIR=storage/outputs

# Server Settings
HOST=127.0.0.1
PORT=8000
